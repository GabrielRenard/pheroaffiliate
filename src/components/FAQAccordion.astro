---
import type { FaqItem } from '../types';

export interface Props {
  faqs: FaqItem[];
  title?: string;
}

const { faqs, title = 'Frequently Asked Questions' } = Astro.props;

if (!faqs || faqs.length === 0) return null;
---

<section class="faq-section" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="faq-heading">{title}</h2>
  <div class="faq-list">
    {faqs.map((faq, i) => (
      <details class="faq-item" name="faq-group">
        <summary class="faq-question" id={`faq-${i}`}>
          <span>{faq.question}</span>
          <svg class="faq-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <div class="faq-answer">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section {
    margin-top: 2.5rem;
  }

  .faq-heading {
    margin-bottom: 1.25rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .faq-item[open] {
    border-color: var(--color-accent);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.125rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9375rem;
    list-style: none;
    color: var(--color-text);
    gap: 0.75rem;
    user-select: none;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question:hover {
    background: var(--color-accent-light);
  }

  .faq-item[open] .faq-question {
    background: var(--color-accent-light);
    color: var(--color-accent-dark);
  }

  .faq-icon {
    flex-shrink: 0;
    transition: transform 0.2s;
    color: var(--color-text-muted);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    color: var(--color-accent-dark);
  }

  .faq-answer {
    padding: 0 1.125rem 1rem;
    border-top: 1px solid var(--color-border);
  }

  .faq-answer p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0.75rem 0 0;
  }
</style>
