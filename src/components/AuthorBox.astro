---
import type { Author } from '../types';

export interface Props {
  author: Author;
  reviewedAt?: string;
}

const { author, reviewedAt } = Astro.props;

const reviewDate = reviewedAt
  ? new Date(reviewedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<div class="author-box">
  {author.photoUrl && (
    <img src={author.photoUrl} alt={author.name} class="author-photo" loading="lazy" />
  )}
  <div class="author-info">
    <p class="author-reviewed-by">Reviewed by</p>
    <p class="author-name">{author.name}</p>
    {author.credentials && <p class="author-credentials">{author.credentials}</p>}
    {reviewDate && <p class="author-date">Last updated: {reviewDate}</p>}
  </div>
</div>

<style>
  .author-box {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }

  .author-photo {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--color-border);
  }

  .author-reviewed-by {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    margin: 0;
  }

  .author-name {
    font-weight: 700;
    font-size: 0.9375rem;
    margin: 0.15rem 0 0;
    color: var(--color-text);
  }

  .author-credentials {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0.1rem 0 0;
  }

  .author-date {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0.2rem 0 0;
  }
</style>
