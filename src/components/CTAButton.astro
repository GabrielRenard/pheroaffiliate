---
export interface Props {
  href: string;
  label?: string;
  variant?: 'primary' | 'outline' | 'gold';
  size?: 'default' | 'lg';
  showDisclaimer?: boolean;
  class?: string;
}

const {
  href,
  label = 'Check Price & Buy →',
  variant = 'primary',
  size = 'default',
  showDisclaimer = true,
  class: className = '',
} = Astro.props;
---

<div class={`cta-wrap ${className}`}>
  <a
    href={href}
    class={`btn btn-${variant} ${size === 'lg' ? 'btn-lg' : ''} cta-btn`}
    rel="nofollow noopener noreferrer"
    target="_blank"
  >
    {label}
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
      <polyline points="15 3 21 3 21 9"/>
      <line x1="10" y1="14" x2="21" y2="3"/>
    </svg>
  </a>
  {showDisclaimer && (
    <p class="cta-disclaimer">
      *Affiliate link — <a href="/affiliate-disclosure/">disclosure</a>. Price may vary.
    </p>
  )}
</div>

<style>
  .cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .cta-btn {
    gap: 0.5rem;
  }

  .btn-gold {
    background: var(--color-gold);
    color: #fff;
    font-size: 1rem;
  }

  .btn-gold:hover {
    background: #b45309;
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(180, 83, 9, 0.35);
  }

  .cta-disclaimer {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .cta-disclaimer a {
    color: inherit;
  }
</style>
