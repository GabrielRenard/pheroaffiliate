---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StarRating from '../../components/StarRating.astro';
import ProsCons from '../../components/ProsCons.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CTAButton from '../../components/CTAButton.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import { sanityFetch } from '../../lib/sanity';
import { productQuery, allProductSlugsQuery } from '../../lib/queries';
import { buildMetadata } from '../../utils/metadata';
import {
  buildProductSchema,
  buildReviewSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
  schemaToScript,
} from '../../utils/structuredData';
import type { Product } from '../../types';

export async function getStaticPaths() {
  const slugs = await sanityFetch<Array<{ slug: string }>>(allProductSlugsQuery);
  return slugs.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const product = await sanityFetch<Product>(productQuery, { slug });

if (!product) {
  return Astro.redirect('/404');
}

const meta = buildMetadata({
  title: product.seoTitle || `${product.name} Review — Is It Worth It?`,
  description:
    product.seoDescription ||
    product.summary ||
    `Read our in-depth review of ${product.name} by ${product.brand}. Pros, cons, score, and where to buy.`,
  path: `/products/${slug}/`,
  seoTitle: product.seoTitle,
  seoDescription: product.seoDescription,
  ogImageUrl: product.ogImageUrl || product.featuredImageUrl,
  canonicalUrl: product.canonicalUrl,
  noindex: product.noindex,
  type: 'article',
  publishedAt: product.publishedAt,
  updatedAt: product.lastReviewedAt,
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    ...(product.categories?.[0]
      ? [{ name: product.categories[0].name, url: `/category/${product.categories[0].slug}/` }]
      : []),
    { name: product.name, url: `/products/${slug}/` },
  ]),
  buildProductSchema(product),
  buildReviewSchema(product),
  buildFaqSchema(product.faqs || []),
].filter(Boolean) as object[];

const typeLabels: Record<string, string> = {
  edp: 'Eau de Parfum',
  edt: 'Eau de Toilette',
  oil: 'Oil / Concentrate',
  spray_unscented: 'Unscented Spray',
  spray_scented: 'Scented Spray',
  cologne: 'Cologne',
  body_lotion: 'Body Lotion',
};

const projectionLabels: Record<string, string> = {
  soft: 'Soft / Skin-close',
  moderate: 'Moderate',
  strong: 'Strong',
  beast: 'Beast Mode',
};
---

<BaseLayout meta={meta} schemas={schemas}>
  <article class="product-page">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          ...(product.categories?.[0]
            ? [{ name: product.categories[0].name, href: `/category/${product.categories[0].slug}/` }]
            : []),
          { name: product.name },
        ]}
      />

      <!-- Header -->
      <header class="product-header">
        <div class="product-header-content">
          <div class="product-badges">
            {product.categories?.map((cat) => (
              <a href={`/category/${cat.slug}/`} class="badge badge-category">{cat.name}</a>
            ))}
            {product.intendedAudience && (
              <span class="badge badge-audience">{product.intendedAudience}</span>
            )}
          </div>
          <h1 class="product-title">{product.name}</h1>
          <p class="product-brand">by <strong>{product.brand}</strong></p>

          {product.reviewScore !== undefined && product.reviewScore !== null && (
            <div class="product-rating-row">
              <StarRating score={product.reviewScore} size="lg" />
              <span class="rating-label">Editorial Score</span>
            </div>
          )}

          {product.summary && (
            <p class="product-summary">{product.summary}</p>
          )}

          {product.author && (
            <AuthorBox author={product.author} reviewedAt={product.lastReviewedAt} />
          )}
        </div>

        {product.featuredImageUrl && (
          <div class="product-hero-image-wrap">
            <img
              src={product.featuredImageUrl}
              alt={product.featuredImageAlt || product.name}
              class="product-hero-image"
              loading="eager"
              width="500"
              height="500"
            />
          </div>
        )}
      </header>

      <!-- Sticky CTA bar (desktop) -->
      <div class="sticky-cta-bar" aria-label="Buy this product">
        <div class="sticky-cta-inner">
          <div class="sticky-cta-product">
            <strong>{product.name}</strong>
            {product.reviewScore !== undefined && (
              <StarRating score={product.reviewScore} size="sm" />
            )}
          </div>
          <CTAButton
            href={product.affiliateUrl}
            label="Check Price →"
            variant="primary"
            showDisclaimer={false}
          />
        </div>
      </div>

      <div class="product-layout">
        <div class="product-main">
          <!-- Quick specs -->
          <section class="specs-section" aria-labelledby="specs-heading">
            <h2 id="specs-heading">Product Specs at a Glance</h2>
            <dl class="specs-grid">
              {product.productType && (
                <>
                  <dt>Type</dt>
                  <dd>{typeLabels[product.productType] || product.productType}</dd>
                </>
              )}
              {product.intendedAudience && (
                <>
                  <dt>For</dt>
                  <dd class="capitalize">{product.intendedAudience}</dd>
                </>
              )}
              {product.scentProfile && (
                <>
                  <dt>Scent Profile</dt>
                  <dd>{product.scentProfile}</dd>
                </>
              )}
              {product.longevity != null && (
                <>
                  <dt>Longevity</dt>
                  <dd>~{product.longevity} hours</dd>
                </>
              )}
              {product.projection && (
                <>
                  <dt>Projection</dt>
                  <dd>{projectionLabels[product.projection] || product.projection}</dd>
                </>
              )}
              {product.price && (
                <>
                  <dt>Approx. Price</dt>
                  <dd>${product.price}</dd>
                </>
              )}
            </dl>
          </section>

          <!-- Pros / Cons -->
          {product.pros?.length || product.cons?.length ? (
            <ProsCons pros={product.pros || []} cons={product.cons || []} />
          ) : null}

          <!-- Body -->
          {product.body && Array.isArray(product.body) && product.body.length > 0 && (
            <section class="review-body" aria-labelledby="review-body-heading">
              <h2 id="review-body-heading">Full Review</h2>
              <PortableTextRenderer content={product.body as any[]} />
            </section>
          )}

          <!-- Ingredient notes -->
          {product.ingredientNotes && (
            <section aria-labelledby="ingredients-heading">
              <h2 id="ingredients-heading">Ingredient Notes</h2>
              <p>{product.ingredientNotes}</p>
            </section>
          )}

          <!-- Verdict -->
          {product.editorialVerdict && (
            <div class="verdict-box">
              <h2 class="verdict-heading">Our Verdict</h2>
              <p>{product.editorialVerdict}</p>
              <CTAButton
                href={product.affiliateUrl}
                label="Check Current Price →"
                variant="gold"
                size="lg"
              />
            </div>
          )}

          <!-- FAQs -->
          {product.faqs && product.faqs.length > 0 && (
            <FAQAccordion faqs={product.faqs} />
          )}
        </div>

        <!-- Sidebar -->
        <aside class="product-sidebar" aria-label="Buy this product">
          <div class="sidebar-card">
            {product.featuredImageUrl && (
              <img
                src={product.featuredImageUrl}
                alt={product.featuredImageAlt || product.name}
                class="sidebar-img"
                loading="lazy"
              />
            )}
            <h3 class="sidebar-product-name">{product.name}</h3>
            <p class="sidebar-brand">{product.brand}</p>

            {product.reviewScore !== undefined && product.reviewScore !== null && (
              <StarRating score={product.reviewScore} size="md" />
            )}

            {product.price && (
              <p class="sidebar-price">~${product.price}</p>
            )}

            <CTAButton
              href={product.affiliateUrl}
              label="Check Price & Buy →"
              variant="primary"
              size="lg"
              showDisclaimer
              class="sidebar-cta"
            />

            {product.pros && product.pros.length > 0 && (
              <div class="sidebar-pros">
                <p class="sidebar-pros-heading">Why people buy it</p>
                <ul>
                  {product.pros.slice(0, 3).map((pro) => (
                    <li>{pro}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </aside>
      </div>

      <!-- Related products -->
      {product.relatedProducts && product.relatedProducts.length > 0 && (
        <RelatedContent products={product.relatedProducts} title="Related Products" />
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .product-page {
    padding-block: 2rem 4rem;
  }

  .product-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: flex-start;
    margin-bottom: 2rem;
  }

  .product-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .badge-category {
    background: var(--color-accent-light);
    color: var(--color-accent-dark);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .badge-audience {
    background: #f0fdf4;
    color: #166534;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .product-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .product-brand {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .product-rating-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .rating-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .product-summary {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 600px;
  }

  .product-hero-image-wrap {
    flex-shrink: 0;
    width: 280px;
  }

  .product-hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  /* Sticky CTA */
  .sticky-cta-bar {
    position: sticky;
    top: 64px;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    padding: 0.625rem 0;
    display: none;
  }

  @media (min-width: 900px) {
    .sticky-cta-bar { display: block; }
  }

  .sticky-cta-inner {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .sticky-cta-product {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  /* Product layout */
  .product-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2.5rem;
    align-items: flex-start;
  }

  /* Specs */
  .specs-section {
    margin-bottom: 2rem;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .specs-grid dt {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .specs-grid dd {
    font-size: 0.9375rem;
    margin: 0;
    color: var(--color-text);
  }

  .capitalize { text-transform: capitalize; }

  /* Review body */
  .review-body {
    margin-bottom: 2rem;
  }

  /* Verdict */
  .verdict-box {
    background: linear-gradient(135deg, #1e1b4b, #4c1d95);
    color: #fff;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    margin: 2rem 0;
  }

  .verdict-heading {
    color: #fff;
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .verdict-box p {
    color: rgba(255,255,255,0.85);
    margin-bottom: 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  /* Sidebar */
  .sidebar-card {
    position: sticky;
    top: 120px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
  }

  .sidebar-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .sidebar-product-name {
    font-size: 1rem;
    margin: 0;
    line-height: 1.3;
  }

  .sidebar-brand {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .sidebar-price {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text);
  }

  .sidebar-cta {
    width: 100%;
  }

  .sidebar-cta :global(.cta-wrap) {
    width: 100%;
  }

  .sidebar-cta :global(.btn) {
    width: 100%;
    justify-content: center;
  }

  .sidebar-pros {
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
  }

  .sidebar-pros-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 0.4rem;
  }

  .sidebar-pros ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .sidebar-pros li {
    font-size: 0.8125rem;
    padding-left: 1rem;
    position: relative;
    line-height: 1.4;
  }

  .sidebar-pros li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-green);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .product-header {
      grid-template-columns: 1fr;
    }
    .product-hero-image-wrap {
      width: 100%;
      max-width: 360px;
      order: -1;
    }
    .product-layout {
      grid-template-columns: 1fr;
    }
    .sidebar-card {
      position: static;
    }
  }
</style>
