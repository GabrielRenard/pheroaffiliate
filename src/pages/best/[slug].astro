---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StarRating from '../../components/StarRating.astro';
import CTAButton from '../../components/CTAButton.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import { sanityFetch } from '../../lib/sanity';
import { bestListQuery, allBestListSlugsQuery } from '../../lib/queries';
import { buildMetadata } from '../../utils/metadata';
import { buildBreadcrumbSchema, buildArticleSchema, buildFaqSchema } from '../../utils/structuredData';
import type { BestList } from '../../types';

export async function getStaticPaths() {
  const slugs = await sanityFetch<Array<{ slug: string }>>(allBestListSlugsQuery);
  return slugs.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const list = await sanityFetch<BestList>(bestListQuery, { slug });

if (!list) return Astro.redirect('/404');

const sortedPicks = [...(list.picks || [])].sort((a, b) => (a.rank ?? 99) - (b.rank ?? 99));

const meta = buildMetadata({
  title: list.seoTitle || list.title,
  description: list.seoDescription || list.headline || `Our expert picks for ${list.title.toLowerCase()}.`,
  path: `/best/${slug}/`,
  seoTitle: list.seoTitle,
  seoDescription: list.seoDescription,
  ogImageUrl: list.ogImageUrl || list.coverImageUrl,
  canonicalUrl: list.canonicalUrl,
  noindex: list.noindex,
  type: 'article',
  publishedAt: list.publishedAt,
  updatedAt: list.updatedAt,
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Best Lists', url: '/best/best-pheromone-colognes-for-men/' },
    { name: list.title, url: `/best/${slug}/` },
  ]),
  buildArticleSchema({
    title: list.title,
    excerpt: list.headline,
    slug: `/best/${slug}/`,
    imageUrl: list.coverImageUrl,
    authorName: list.author?.name,
    publishedAt: list.publishedAt,
    updatedAt: list.updatedAt,
  }),
  buildFaqSchema(list.faqs || []),
].filter(Boolean) as object[];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="best-page">
    <div class="container">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Best Lists', href: '/best/best-pheromone-colognes-for-men/' },
          { name: list.title },
        ]}
      />

      <header class="best-header">
        <span class="best-label">Best-Of Guide</span>
        <h1>{list.title}</h1>
        {list.headline && <p class="best-headline">{list.headline}</p>}
        {list.author && <AuthorBox author={list.author} reviewedAt={list.updatedAt} />}
      </header>

      <!-- Quick picks nav -->
      <nav class="picks-nav" aria-label="Jump to pick">
        <p class="picks-nav-label">Jump to:</p>
        <ol class="picks-nav-list">
          {sortedPicks.map((pick, i) => (
            <li>
              <a href={`#pick-${i + 1}`} class="picks-nav-link">
                <span class="picks-nav-rank">#{pick.rank ?? i + 1}</span>
                <span>{pick.product.name}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- Picks -->
      <ol class="picks-list" aria-label={`${list.title} — our picks`}>
        {sortedPicks.map((pick, i) => (
          <li class="pick-item" id={`pick-${i + 1}`}>
            <div class="pick-rank">
              <span class="rank-number">#{pick.rank ?? i + 1}</span>
              {pick.award && <span class="pick-award">{pick.award}</span>}
            </div>

            <div class="pick-card">
              <div class="pick-image-col">
                {pick.product.featuredImageUrl && (
                  <a href={`/products/${pick.product.slug}/`}>
                    <img
                      src={pick.product.featuredImageUrl}
                      alt={pick.product.featuredImageAlt || pick.product.name}
                      class="pick-image"
                      loading="lazy"
                      width="200"
                      height="200"
                    />
                  </a>
                )}
              </div>

              <div class="pick-content">
                <h2 class="pick-name">
                  <a href={`/products/${pick.product.slug}/`}>{pick.product.name}</a>
                </h2>
                <p class="pick-brand">{pick.product.brand}</p>

                {pick.product.reviewScore !== undefined && pick.product.reviewScore !== null && (
                  <StarRating score={pick.product.reviewScore} size="sm" />
                )}

                {pick.pickSummary && <p class="pick-summary">{pick.pickSummary}</p>}

                {pick.product.pros && pick.product.pros.length > 0 && (
                  <ul class="pick-pros">
                    {pick.product.pros.slice(0, 3).map((pro: string) => (
                      <li>{pro}</li>
                    ))}
                  </ul>
                )}

                <div class="pick-actions">
                  <CTAButton
                    href={pick.product.affiliateUrl}
                    label="Check Price →"
                    showDisclaimer
                  />
                  <a href={`/products/${pick.product.slug}/`} class="pick-review-link">
                    Read full review →
                  </a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>

      {list.body && Array.isArray(list.body) && list.body.length > 0 && (
        <section class="best-body" aria-labelledby="best-body-heading">
          <h2 id="best-body-heading">More Details</h2>
          <PortableTextRenderer content={list.body as any[]} />
        </section>
      )}

      {list.faqs && list.faqs.length > 0 && (
        <FAQAccordion faqs={list.faqs} />
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .best-page {
    padding-block: 2rem 4rem;
  }

  .best-header {
    margin-bottom: 2rem;
  }

  .best-label {
    display: inline-block;
    background: var(--color-accent-light);
    color: var(--color-accent-dark);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .best-header h1 {
    margin-bottom: 0.5rem;
  }

  .best-headline {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: 1.65;
    margin: 0;
  }

  /* Quick nav */
  .picks-nav {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .picks-nav-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
  }

  .picks-nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: none;
  }

  .picks-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent-dark);
    background: var(--color-accent-light);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    transition: background 0.15s;
  }

  .picks-nav-link:hover {
    background: #ddd6fe;
  }

  .picks-nav-rank {
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.7;
  }

  /* Picks */
  .picks-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
  }

  .pick-item {
    position: relative;
  }

  .pick-rank {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .rank-number {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-accent-dark);
    background: var(--color-accent-light);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .pick-award {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold);
    background: #fef3c7;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .pick-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    align-items: flex-start;
    box-shadow: var(--shadow-sm);
  }

  .pick-image-col {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .pick-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    transition: transform 0.25s;
  }

  .pick-image:hover {
    transform: scale(1.03);
  }

  .pick-name {
    font-size: 1.25rem;
    margin: 0 0 0.2rem;
  }

  .pick-name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .pick-name a:hover {
    color: var(--color-accent-dark);
  }

  .pick-brand {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }

  .pick-summary {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0.75rem 0 1rem;
  }

  .pick-pros {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .pick-pros li {
    font-size: 0.875rem;
    padding-left: 1.1rem;
    position: relative;
    color: var(--color-text);
    line-height: 1.45;
  }

  .pick-pros li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-green);
    font-weight: 700;
  }

  .pick-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .pick-review-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: none;
  }

  .pick-review-link:hover {
    text-decoration: underline;
  }

  .best-body {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .pick-card {
      grid-template-columns: 1fr;
    }
    .pick-image-col {
      max-width: 200px;
    }
  }
</style>
