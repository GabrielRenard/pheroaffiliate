---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { sanityFetch } from '../../lib/sanity';
import { allGuideQuery } from '../../lib/queries';
import { buildMetadata } from '../../utils/metadata';
import { buildBreadcrumbSchema } from '../../utils/structuredData';

const guides = await sanityFetch<any[]>(allGuideQuery);

const meta = buildMetadata({
  title: 'Pheromone Guides — How They Work, What to Expect',
  description:
    'Educational guides on pheromone science, how to choose a product, what the research says, and more. Honest information, no hype.',
  path: '/guides/',
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Guides', url: '/guides/' },
  ]),
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="guides-index">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides' }]} />

      <header class="page-header">
        <h1>Pheromone Guides</h1>
        <p class="page-subtitle">
          We cut through the marketing noise. These guides explain the science behind pheromones,
          how to evaluate products critically, and what to realistically expect.
        </p>
      </header>

      {guides && guides.length > 0 ? (
        <div class="guides-grid">
          {guides.map((guide) => (
            <article class="guide-card">
              {guide.coverImageUrl && (
                <a href={`/guides/${guide.slug}/`} class="guide-card-image-link">
                  <img
                    src={guide.coverImageUrl}
                    alt={guide.title}
                    class="guide-card-image"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="guide-card-body">
                {guide.publishedAt && (
                  <time class="guide-date" datetime={guide.publishedAt}>
                    {new Date(guide.publishedAt).toLocaleDateString('en-US', {
                      year: 'numeric', month: 'long', day: 'numeric'
                    })}
                  </time>
                )}
                <h2 class="guide-card-title">
                  <a href={`/guides/${guide.slug}/`}>{guide.title}</a>
                </h2>
                {guide.excerpt && <p class="guide-card-excerpt">{guide.excerpt}</p>}
                <a href={`/guides/${guide.slug}/`} class="guide-card-link">Read guide →</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No guides published yet. Check back soon.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .guides-index {
    padding-block: 2rem 4rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-header h1 {
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 620px;
    line-height: 1.7;
    margin: 0;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .guide-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .guide-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .guide-card-image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  .guide-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .guide-card:hover .guide-card-image {
    transform: scale(1.03);
  }

  .guide-card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .guide-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .guide-card-title {
    font-size: 1.125rem;
    margin: 0;
    line-height: 1.3;
  }

  .guide-card-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .guide-card-title a:hover {
    color: var(--color-accent-dark);
  }

  .guide-card-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guide-card-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: none;
    margin-top: auto;
  }

  .guide-card-link:hover {
    text-decoration: underline;
  }

  .empty-state {
    text-align: center;
    padding: 4rem;
    color: var(--color-text-muted);
  }
</style>
