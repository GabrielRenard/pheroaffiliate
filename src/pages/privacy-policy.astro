---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildMetadata } from '../utils/metadata';
import { buildBreadcrumbSchema } from '../utils/structuredData';

const meta = buildMetadata({
  title: 'Privacy Policy | PheroGuide',
  description: 'How PheroGuide collects, uses, and protects your personal information.',
  path: '/privacy-policy/',
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Privacy Policy', url: '/privacy-policy/' },
  ]),
];

const updatedDate = 'January 1, 2024';
const siteEmail = 'privacy@pheroguide.com';
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="static-page">
    <div class="container container--narrow">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Privacy Policy' }]} />

      <h1>Privacy Policy</h1>
      <p class="updated-date">Last updated: {updatedDate}</p>

      <p>
        This Privacy Policy describes how PheroGuide ("we," "us," or "our") collects, uses, and
        shares information when you visit pheroguide.com (the "Site").
      </p>

      <section>
        <h2>Information We Collect</h2>
        <h3>Information You Provide</h3>
        <p>
          If you contact us through our contact form, we collect the name, email address, and
          message content you provide. We use this solely to respond to your inquiry.
        </p>
        <h3>Automatically Collected Information</h3>
        <p>
          Like most websites, we may collect standard log data including IP addresses, browser
          type, pages visited, and time spent on the Site. This data is used in aggregate to
          understand how visitors use our Site and to improve content.
        </p>
      </section>

      <section>
        <h2>Cookies & Tracking</h2>
        <p>
          We may use cookies and similar technologies for analytics (e.g., understanding which
          pages are most popular) and for affiliate tracking purposes. Affiliate program cookies
          are set by third-party retailers when you click through our affiliate links.
        </p>
        <p>
          You can control cookies through your browser settings. Disabling cookies will not
          prevent you from reading our content.
        </p>
      </section>

      <section>
        <h2>Third-Party Services</h2>
        <p>
          Our Site may include links to third-party retailers and services. These third parties
          have their own privacy policies. We are not responsible for the privacy practices of
          external sites.
        </p>
        <p>
          We may use third-party analytics services (such as Google Analytics) to better
          understand site usage. These services may collect information about your browsing
          habits in accordance with their own privacy policies.
        </p>
      </section>

      <section>
        <h2>Data Sharing</h2>
        <p>
          We do not sell, trade, or rent your personal information to third parties.
          We may share aggregate, non-personally identifiable data for research or reporting purposes.
        </p>
      </section>

      <section>
        <h2>Data Retention</h2>
        <p>
          Contact form submissions are retained for up to 12 months, then deleted unless
          ongoing correspondence requires otherwise.
        </p>
      </section>

      <section>
        <h2>Your Rights</h2>
        <p>
          Depending on your jurisdiction, you may have rights to access, correct, or delete
          personal data we hold about you. To exercise these rights, please contact us at
          <a href={`mailto:${siteEmail}`}>{siteEmail}</a>.
        </p>
      </section>

      <section>
        <h2>Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy periodically. Material changes will be noted with
          an updated "Last updated" date at the top of this page.
        </p>
      </section>

      <section>
        <h2>Contact</h2>
        <p>
          Questions about this Privacy Policy? Email us at
          <a href={`mailto:${siteEmail}`}>{siteEmail}</a> or use our
          <a href="/contact/">contact form</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .static-page { padding-block: 2rem 5rem; }
  .container--narrow { max-width: 760px; }
  h1 { margin-bottom: 0.25rem; }
  .updated-date { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1.5rem; }
  section { margin-bottom: 2rem; }
  section h2 { font-size: 1.3rem; margin-bottom: 0.65rem; }
  section h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
  p { color: var(--color-text-muted); line-height: 1.75; margin-bottom: 0.75rem; }
  a { font-weight: 500; }
</style>
