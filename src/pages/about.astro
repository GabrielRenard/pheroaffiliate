---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildMetadata } from '../utils/metadata';
import { buildBreadcrumbSchema } from '../utils/structuredData';

const meta = buildMetadata({
  title: 'About PheroGuide — Our Mission & Review Process',
  description:
    'PheroGuide is an independent editorial site dedicated to honest, research-backed reviews of pheromone-infused fragrances and related products.',
  path: '/about/',
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]),
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="static-page">
    <div class="container container--narrow">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'About' }]} />

      <h1>About PheroGuide</h1>

      <section>
        <h2>Our Mission</h2>
        <p>
          PheroGuide was founded to bring genuine, unbiased reviews to a product category flooded
          with exaggerated marketing claims. Pheromone-infused fragrances occupy a genuine niche —
          some people love them, some notice no effect — and we believe you deserve honest
          information to help you decide if they're right for you.
        </p>
        <p>
          We don't promise that any product will "guarantee attraction" or make dramatic changes
          to social dynamics. What we do promise is that every review reflects real testing,
          transparent methodology, and editorial independence.
        </p>
      </section>

      <section>
        <h2>How We Review Products</h2>
        <ol class="process-list">
          <li>
            <strong>We buy our own products.</strong> We don't accept free products in exchange for
            positive reviews. Every product featured was purchased independently unless explicitly stated.
          </li>
          <li>
            <strong>We test across multiple wearers and contexts.</strong> A single data point isn't
            a review. We gather feedback from multiple testers when possible.
          </li>
          <li>
            <strong>We score on a 0–10 scale.</strong> Our scores reflect scent quality, longevity,
            value for money, and overall user satisfaction — not affiliate revenue potential.
          </li>
          <li>
            <strong>We update reviews.</strong> Formulations change, prices change, and products
            get discontinued. We revisit reviews and mark when they were last evaluated.
          </li>
          <li>
            <strong>We acknowledge the science — and its limits.</strong> The evidence on synthetic
            pheromones in humans is mixed. We explain what the research says without overstating it.
          </li>
        </ol>
      </section>

      <section>
        <h2>Affiliate Relationships</h2>
        <p>
          Like most editorial sites, we use affiliate links to sustain our work. When you click a
          "Check Price" or "Buy" link and make a purchase, we may earn a commission — at no extra
          cost to you. This does not influence our editorial scores or conclusions.
        </p>
        <p>
          <a href="/affiliate-disclosure/">Read our full affiliate disclosure policy →</a>
        </p>
      </section>

      <section>
        <h2>Our Team</h2>
        <p>
          PheroGuide is maintained by a small team of fragrance researchers and product reviewers
          who have collectively spent over a decade evaluating perfumes, colognes, and specialty
          scent products. Our editorial team applies rigorous standards to ensure every piece of
          content is accurate, useful, and trustworthy.
        </p>
      </section>

      <section>
        <h2>Contact Us</h2>
        <p>
          Have a question, spotted an error, or want to suggest a product for review?
          <a href="/contact/">Get in touch →</a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .static-page {
    padding-block: 2rem 5rem;
  }

  .container--narrow {
    max-width: 760px;
  }

  h1 { margin-bottom: 2rem; }

  section {
    margin-bottom: 2.5rem;
  }

  section h2 {
    margin-bottom: 0.75rem;
    font-size: 1.4rem;
  }

  p {
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  a { font-weight: 500; }

  .process-list {
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .process-list li {
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .process-list strong {
    color: var(--color-text);
  }
</style>
