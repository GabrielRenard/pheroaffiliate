---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import PortableTextRenderer from '../../components/PortableTextRenderer.astro';
import { sanityFetch } from '../../lib/sanity';
import {
  categoryQuery,
  productsByCategoryQuery,
  allCategorySlugsQuery,
} from '../../lib/queries';
import { buildMetadata } from '../../utils/metadata';
import { buildBreadcrumbSchema, buildArticleSchema } from '../../utils/structuredData';
import type { Category, ProductCard as ProductCardType } from '../../types';

export async function getStaticPaths() {
  const slugs = await sanityFetch<Array<{ slug: string }>>(allCategorySlugsQuery);
  return slugs.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const [category, products] = await Promise.all([
  sanityFetch<Category>(categoryQuery, { slug }),
  sanityFetch<ProductCardType[]>(productsByCategoryQuery, { slug }),
]);

if (!category) return Astro.redirect('/404');

const meta = buildMetadata({
  title: category.seoTitle || `${category.name} — Reviews & Buying Guide`,
  description:
    category.seoDescription ||
    category.description ||
    `Browse our expert reviews of ${category.name.toLowerCase()} products. Honest comparisons to help you decide.`,
  path: `/category/${slug}/`,
  seoTitle: category.seoTitle,
  seoDescription: category.seoDescription,
  ogImageUrl: category.ogImageUrl || category.heroImageUrl,
  canonicalUrl: category.canonicalUrl,
  noindex: category.noindex,
  type: 'website',
  updatedAt: category.updatedAt,
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: category.name, url: `/category/${slug}/` },
  ]),
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="category-page">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: category.name }]} />

      <header class="category-header">
        {category.heroImageUrl && (
          <div class="category-hero-image-wrap">
            <img
              src={category.heroImageUrl}
              alt={category.heroImageAlt || category.name}
              class="category-hero-image"
              loading="eager"
            />
          </div>
        )}
        <h1>{category.name}</h1>
        {category.description && <p class="category-desc">{category.description}</p>}
      </header>

      {category.intro && Array.isArray(category.intro) && category.intro.length > 0 && (
        <div class="category-intro">
          <PortableTextRenderer content={category.intro as any[]} />
        </div>
      )}

      <section aria-labelledby="products-heading">
        <div class="products-header">
          <h2 id="products-heading">
            {products.length} {category.name} Product{products.length !== 1 ? 's' : ''} Reviewed
          </h2>
          <p class="products-sort-hint">Sorted by our editorial score</p>
        </div>

        {products.length > 0 ? (
          <div class="grid-auto-3">
            {products.map((product, i) => (
              <ProductCard product={product} featured={i === 0} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No products reviewed yet in this category. Check back soon.</p>
            <a href="/" class="btn btn-outline">Back to Home →</a>
          </div>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    padding-block: 2rem 4rem;
  }

  .category-header {
    margin-bottom: 2rem;
  }

  .category-hero-image-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 1.5rem;
    max-height: 320px;
  }

  .category-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-header h1 {
    margin-bottom: 0.5rem;
  }

  .category-desc {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: 1.7;
    margin: 0;
  }

  .category-intro {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .products-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .products-header h2 {
    margin: 0;
  }

  .products-sort-hint {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .empty-state p {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
</style>
