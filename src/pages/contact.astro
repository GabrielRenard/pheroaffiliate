---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildMetadata } from '../utils/metadata';
import { buildBreadcrumbSchema } from '../utils/structuredData';

const meta = buildMetadata({
  title: 'Contact PheroGuide',
  description: 'Get in touch with the PheroGuide team. Questions, feedback, product suggestions, or corrections — we read everything.',
  path: '/contact/',
  noindex: false,
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' },
  ]),
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="static-page">
    <div class="container container--narrow">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />

      <h1>Contact Us</h1>
      <p class="page-intro">
        We're a small team and we read every message. Whether you've spotted an error, have a
        product recommendation, or want to ask a question about our review process — please reach out.
      </p>

      <section>
        <h2>Send a Message</h2>
        <form class="contact-form" action="#" method="post" aria-label="Contact form">
          <div class="form-group">
            <label for="name" class="form-label">Your Name</label>
            <input type="text" id="name" name="name" class="form-input" required autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" class="form-input" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="subject" class="form-label">Subject</label>
            <select id="subject" name="subject" class="form-select">
              <option value="question">General question</option>
              <option value="correction">Correction / error report</option>
              <option value="product">Product suggestion</option>
              <option value="review-request">Request a review</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" class="form-textarea" rows="6" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send Message →</button>
          <p class="form-note">We aim to respond within 2–3 business days.</p>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .static-page {
    padding-block: 2rem 5rem;
  }

  .container--narrow {
    max-width: 640px;
  }

  h1 { margin-bottom: 0.5rem; }

  .page-intro {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  section h2 {
    margin-bottom: 1.25rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .form-input,
  .form-select,
  .form-textarea {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 140px;
  }

  .form-note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
