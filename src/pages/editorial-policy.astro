---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildMetadata } from '../utils/metadata';
import { buildBreadcrumbSchema } from '../utils/structuredData';

const meta = buildMetadata({
  title: 'Editorial Policy | PheroGuide',
  description: 'How PheroGuide selects, tests, and scores products. Our standards for accuracy, independence, and transparency.',
  path: '/editorial-policy/',
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Editorial Policy', url: '/editorial-policy/' },
  ]),
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="static-page">
    <div class="container container--narrow">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Editorial Policy' }]} />

      <h1>Editorial Policy</h1>

      <section>
        <h2>Our Standards</h2>
        <p>
          PheroGuide is committed to providing accurate, fair, and useful information about
          pheromone-infused fragrances and related products. Every piece of content is written
          by a human reviewer with hands-on experience or relevant expertise.
        </p>
      </section>

      <section>
        <h2>Product Selection</h2>
        <p>
          Products are selected based on market relevance, reader interest, and our ability to
          test them properly. We do not guarantee coverage of any specific product. Being
          approached by a brand does not automatically lead to a review.
        </p>
      </section>

      <section>
        <h2>Review Methodology</h2>
        <ul>
          <li>Products are tested for a minimum of 2 weeks under real-world conditions.</li>
          <li>Scores reflect scent quality (where applicable), longevity, value, and overall user experience.</li>
          <li>We acknowledge where scientific evidence is limited or contested.</li>
          <li>Pros and cons are based on testing, not marketing copy.</li>
        </ul>
      </section>

      <section>
        <h2>Corrections Policy</h2>
        <p>
          If we publish inaccurate information, we correct it promptly and transparently.
          Significant corrections are noted in the article. If you believe we've made an error,
          please <a href="/contact/">contact us</a> with supporting information.
        </p>
      </section>

      <section>
        <h2>Scientific Claims</h2>
        <p>
          The science of human pheromones is genuinely contested. We do not claim that any
          product is scientifically proven to attract others or produce guaranteed social effects.
          Where we cite research, we link to the original source and note its limitations.
          Marketing language from manufacturers is not treated as fact.
        </p>
      </section>

      <section>
        <h2>Affiliate Revenue</h2>
        <p>
          Our content is supported by affiliate commissions. See our
          <a href="/affiliate-disclosure/">affiliate disclosure</a> for full details.
          Affiliate revenue does not influence editorial scores or recommendations.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .static-page { padding-block: 2rem 5rem; }
  .container--narrow { max-width: 760px; }
  h1 { margin-bottom: 1.5rem; }
  section { margin-bottom: 2rem; }
  section h2 { font-size: 1.3rem; margin-bottom: 0.65rem; }
  p, li { color: var(--color-text-muted); line-height: 1.75; }
  p { margin-bottom: 0.75rem; }
  ul { padding-left: 1.5rem; }
  li { margin-bottom: 0.5rem; }
  a { font-weight: 500; }
</style>
