---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildMetadata } from '../utils/metadata';
import { buildBreadcrumbSchema } from '../utils/structuredData';

const meta = buildMetadata({
  title: 'Affiliate Disclosure | PheroGuide',
  description: 'PheroGuide participates in affiliate programs. Learn how our affiliate relationships work and how they affect (and do not affect) our reviews.',
  path: '/affiliate-disclosure/',
});

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Affiliate Disclosure', url: '/affiliate-disclosure/' },
  ]),
];

const updatedDate = 'January 1, 2024';
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="static-page">
    <div class="container container--narrow">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Affiliate Disclosure' }]} />

      <h1>Affiliate Disclosure</h1>
      <p class="updated-date">Last updated: {updatedDate}</p>

      <p>
        PheroGuide (<strong>pheroguide.com</strong>) participates in various affiliate marketing
        programs. This means that when you click on certain links on our site and make a purchase,
        we may receive a commission — at <strong>no additional cost to you</strong>.
      </p>

      <section>
        <h2>How Affiliate Links Work</h2>
        <p>
          When you click a link labeled "Check Price," "Buy Now," or similar, you may be
          directed to a third-party retailer (such as Amazon, brand-owned stores, or other
          approved retailers). If you complete a purchase during that session, we may earn a
          small percentage of the sale as a commission.
        </p>
        <p>
          Affiliate links are marked with disclosures throughout our site, including a banner
          at the top of every page and inline notes near individual links where appropriate.
        </p>
      </section>

      <section>
        <h2>Editorial Independence</h2>
        <p>
          Our editorial scores, recommendations, and opinions are <strong>not influenced by
          affiliate relationships</strong>. We do not accept payment to improve a product's score,
          write a positive review, or rank a product higher in our lists.
        </p>
        <p>
          Products are scored based on our own testing and research methodology. A product
          generating higher affiliate revenue does not receive a higher editorial rating.
          If anything, we apply extra scrutiny to high-commission products.
        </p>
      </section>

      <section>
        <h2>Products We Buy vs. Products Sent to Us</h2>
        <p>
          The majority of products reviewed on PheroGuide are purchased by our team using our
          own funds. When a manufacturer or PR company provides a product at no cost, we
          disclose this clearly in the review and apply the same testing standards regardless.
          Free products do not guarantee coverage or a positive review.
        </p>
      </section>

      <section>
        <h2>FTC Compliance</h2>
        <p>
          This disclosure is made in accordance with the Federal Trade Commission's guidelines
          concerning the use of endorsements and testimonials in advertising
          (<a href="https://www.ftc.gov/business-guidance/resources/ftcs-endorsement-guides-what-people-are-asking" rel="noopener noreferrer" target="_blank">16 CFR Part 255</a>).
        </p>
      </section>

      <section>
        <h2>Questions?</h2>
        <p>
          If you have questions about our affiliate relationships or review process,
          please <a href="/contact/">contact us</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .static-page { padding-block: 2rem 5rem; }
  .container--narrow { max-width: 760px; }
  h1 { margin-bottom: 0.25rem; }
  .updated-date { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1.5rem; }
  section { margin-bottom: 2rem; }
  section h2 { font-size: 1.3rem; margin-bottom: 0.65rem; }
  p { color: var(--color-text-muted); line-height: 1.75; margin-bottom: 0.75rem; }
  strong { color: var(--color-text); }
  a { font-weight: 500; }
</style>
